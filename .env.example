# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LiveKit Cloud (Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Plan B
NEXT_PUBLIC_PLAN_B_URL=https://meet.google.com/xxx-xxxx-xxx
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Local dev against the DEV Supabase project only
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=0
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=

# Must be 1 to let the e2e tests run (dev Supabase project only, never production)
E2E_ALLOW=0
