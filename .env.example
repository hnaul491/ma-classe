# Supabase: the real `ma-classe` project (Project Settings → API). There is no separate dev project.
# Newer dashboards show "publishable" and "secret" keys; they work in place of anon and service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LiveKit Cloud (Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Plan B
NEXT_PUBLIC_PLAN_B_URL=https://meet.google.com/xxx-xxxx-xxx
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Local Supabase CLI stack only (`supabase start`, URL http://127.0.0.1:54321) ---
# Keep these at 0 everywhere else. NEVER enable the Email provider on the production project:
# Google sign-in is the only way in there.
# 1 shows the password sign-in form (needs the Email provider, so local stack only).
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=0
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
# 1 lets the e2e tests run. They also refuse any NEXT_PUBLIC_SUPABASE_URL that is not localhost.
E2E_ALLOW=0
